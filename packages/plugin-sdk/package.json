{
  "name": "@memizy/plugin-sdk",
  "version": "1.0.0-rc.4",
  "description": "Build Memizy learning games (solo and multiplayer) in a single HTML file.",
  "type": "module",
  "main": "./dist/memizy-sdk.cjs",
  "module": "./dist/memizy-sdk.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/memizy-sdk.js",
      "require": "./dist/memizy-sdk.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.bundle.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@memizy/oqse": "^0.3.0",
    "@memizy/protocol": "^1.0.0-rc.4",
    "dompurify": "^3.4.1",
    "marked": "^16.0.0",
    "mutative": "^1.3.0",
    "penpal": "^7.0.6"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.6.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "license": "MIT",
  "author": "Memizy Team",
  "keywords": [
    "memizy",
    "plugin",
    "sdk",
    "oqse",
    "education",
    "multiplayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memizy/memizy.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/memizy/memizy/issues"
  },
  "homepage": "https://github.com/memizy/memizy/tree/main/packages/plugin-sdk#readme"
}
