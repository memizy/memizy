{
  "name": "@memizy/oqse",
  "version": "1.0.0-rc.6",
  "description": "TypeScript SDK and Zod validators for the OQSE specification.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "oqse.md",
    "oqse-manifest.md",
    "oqse-progress.md",
    "oqse-header.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "build": "npm run generate:schemas && tsc && vite build && tsx scripts/fix-types-entry.ts && node ../../scripts/dts-extensions.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "uuid": "^14.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "license": "MIT",
  "author": "Memizy Team",
  "keywords": [
    "oqse",
    "memizy",
    "study-set",
    "quiz",
    "flashcards",
    "education",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memizy/memizy.git",
    "directory": "packages/oqse"
  },
  "bugs": {
    "url": "https://github.com/memizy/memizy/issues"
  },
  "homepage": "https://github.com/memizy/memizy/tree/main/packages/oqse#readme"
}
