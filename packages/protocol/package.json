{
  "name": "@memizy/protocol",
  "version": "1.0.0-rc.6",
  "description": "Memizy Plugin Protocol: types, Zod schemas and helpers shared by @memizy/plugin-sdk and @memizy/host-sdk.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && node ../../scripts/dts-extensions.mjs dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@memizy/oqse": "^1.0.0-rc.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "license": "MIT",
  "author": "Memizy Team",
  "keywords": [
    "memizy",
    "plugin",
    "protocol",
    "oqse",
    "education"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memizy/memizy.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/memizy/memizy/issues"
  },
  "homepage": "https://github.com/memizy/memizy/tree/main/packages/protocol#readme"
}
