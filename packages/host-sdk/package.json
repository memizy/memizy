{
  "name": "@memizy/host-sdk",
  "version": "1.0.0-rc.3",
  "description": "Run Memizy plugins: sandboxed iframes, protocol validation, sessions, storage hooks.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@memizy/oqse": "^0.2.0",
    "@memizy/protocol": "^1.0.0-rc.3",
    "penpal": "^7.0.6"
  },
  "devDependencies": {
    "@memizy/plugin-sdk": "^1.0.0-rc.3",
    "@types/node": "^25.6.0",
    "@types/ws": "^8",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4",
    "ws": "^8"
  },
  "license": "MIT",
  "author": "Memizy Team",
  "keywords": [
    "memizy",
    "plugin",
    "host",
    "sdk",
    "multiplayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/memizy/memizy.git",
    "directory": "packages/host-sdk"
  },
  "bugs": {
    "url": "https://github.com/memizy/memizy/issues"
  },
  "homepage": "https://github.com/memizy/memizy/tree/main/packages/host-sdk#readme"
}
